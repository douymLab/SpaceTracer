    def create_faidx(fasta_path: Path) -> Path:
        """创建samtools faidx索引"""
        logger.info(f"Creating samtools faidx for {fasta_path}")
        
        try:
            subprocess.run(
                ['samtools', 'faidx', str(fasta_path)],
                check=True,
                capture_output=True,
                text=True
            )
            logger.info(f"Faidx created successfully")
            
            # 创建后尝试查找
            fai_file = find_fai_file(fasta_path)
            if fai_file:
                return fai_file
            else:
                # 回退到默认命名
                default_fai = Path(str(fasta_path) + '.fai')
                if default_fai.exists():
                    return default_fai
                else:
                    raise FileNotFoundError("Faidx created but file not found")
                    
        except subprocess.CalledProcessError as e:
            logger.error(f"Failed to create faidx: {e.stderr}")
            raise RuntimeError(f"Could not index {fasta_path}")


    def get_fai_path(fasta_path: Path, create_if_missing: bool = True) -> Path:
        """
        获取fai文件路径
        
        Args:
            fasta_path: fasta文件路径
            create_if_missing: 如果不存在是否创建
        
        Returns:
            fai文件路径
        """
        # 先尝试查找现有的
        fai_file = find_fai_file(fasta_path)
        
        if fai_file:
            return fai_file
        
        # 不存在且需要创建
        if create_if_missing:
            return create_faidx(fasta_path)
        else:
            raise FileNotFoundError(f"No fai file found for {fasta_path}")


    def parse_fai_file(fai_path: Path) -> dict:
        """解析fai文件，返回染色体信息字典"""
        chromosomes = {}
        
        with open(fai_path, 'r') as f:
            for line_num, line in enumerate(f, 1):
                parts = line.strip().split('\t')
                if len(parts) < 2:
                    continue
                
                chrom_name = parts[0]
                try:
                    chrom_length = int(parts[1])
                except ValueError:
                    logger.warning(f"Invalid length in fai line {line_num}: {parts[1]}")
                    continue
                
                chromosomes[chrom_name] = {
                    'length': chrom_length,
                    'line_number': line_num
                }
        
        logger.info(f"Parsed {len(chromosomes)} chromosomes from {fai_path}")
        return chromosomes